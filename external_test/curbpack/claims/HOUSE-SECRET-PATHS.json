{
  "id": "HOUSE-SECRET-PATHS",
  "requirement_id": "HOUSE-SECRET-PATHS",
  "source": "documents",
  "args": {
    "paths": [
      "README.md",
      "SECURITY.md",
      ".well-known/security.txt"
    ]
  },
  "description": "Required house-policy documents contain no secret-like patterns.",
  "severity": "critical",
  "checks": [
    {
      "check": "contents",
      "args": {
        "paths": [
          "README.md",
          "SECURITY.md",
          ".well-known/security.txt"
        ],
        "probes": [
          {
            "kind": "pattern",
            "pattern": "(?i)(AKIA[0-9A-Z]{16}|-----BEGIN (RSA |OPENSSH )?PRIVATE KEY-----|api[_-]?key\\s*[:=]\\s*['\\\"]?[a-zA-Z0-9]{20,})"
          }
        ]
      }
    }
  ]
}
