  "requirement_id": "HOUSE-NO-PLACEHOLDER-SECURITY-DOCS",
  "source": "documents",
  "args": {
    "paths": [
      "SECURITY.md",
      ".well-known/security.txt"
    ]
  },
  "description": "The reviewed security documentation contains no unresolved placeholder text.",
  "severity": "high",
